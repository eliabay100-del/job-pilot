# ---------- APP ----------
APP_NAME=JobPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---------- DATABASE (PostgreSQL) ----------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jobpilot
DB_USERNAME=jobpilot
DB_PASSWORD=change-me

# ---------- REDIS (cache / queue / sessions) ----------
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ---------- STORAGE (S3-compatible; MinIO locally) ----------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=jobpilot
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------- MAIL (Mailpit locally) ----------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@jobpilot.local
MAIL_FROM_NAME="${APP_NAME}"

# ---------- AI PROVIDERS (abstracted; set the ones you use) ----------
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- TELEGRAM ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- GITHUB INTEGRATION (OAuth app, phase 11) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- GOOGLE / GMAIL (OAuth, phase 11) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- PAYMENTS (provider abstraction; fill per provider) ----------
PAYMENT_DEFAULT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ---------- SEARCH ----------
SEARCH_DRIVER=pgsql
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# ---------- MONITORING ----------
SENTRY_DSN=
